unset BASH_ENV PROMPT_COMMAND ENV
if command -v scl_source >/dev/null 2>&1; then
  [ -d /opt/rh/gcc-toolset-9 ] && source scl_source enable gcc-toolset-9
  [ -d /opt/rh/gcc-toolset-13 ] && source scl_source enable gcc-toolset-13
  [ -d /opt/rh/gcc-toolset-15 ] && source scl_source enable gcc-toolset-15
fi
